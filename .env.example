# Generate .env with: bash scripts/configure-local.sh
# Never commit .env. These names document the runtime contract; no reusable secrets are shipped.
COMPOSE_PROJECT_NAME=park-workbench
CATALOG_PORT=8081
PRICING_PORT=8082
BOOKING_PORT=8083
PRICING_MYSQL_PORT=3307
BOOKING_MYSQL_PORT=3308
MONGO_PORT=27017
DEMO_EMPLOYEE_TOKEN=GENERATE_WITH_CONFIGURE_LOCAL
DEMO_GUEST_TOKEN=GENERATE_WITH_CONFIGURE_LOCAL
DEMO_OTHER_GUEST_TOKEN=GENERATE_WITH_CONFIGURE_LOCAL
DEMO_SERVICE_TOKEN=GENERATE_WITH_CONFIGURE_LOCAL
MYSQL_ROOT_PASSWORD=GENERATE_WITH_CONFIGURE_LOCAL
PRICING_DB_PASSWORD=GENERATE_WITH_CONFIGURE_LOCAL
BOOKING_DB_PASSWORD=GENERATE_WITH_CONFIGURE_LOCAL
MONGO_ROOT_PASSWORD=GENERATE_WITH_CONFIGURE_LOCAL
MONGO_APP_PASSWORD=GENERATE_WITH_CONFIGURE_LOCAL
